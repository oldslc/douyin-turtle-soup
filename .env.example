# LLM
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Server
SERVER_PORT=3010

# 抖音弹幕桥接
LIVE_WS_URL=ws://localhost:1088
BRIDGE_ENABLED=true

# 运行模式
V6_MODE=self_hosted

# 游戏参数
ANTI_STALL_INTERVAL=180
ANTI_STALL_MIN=30
ANTI_STALL_DANMAKU=50
ANTI_STALL_DECAY=0.8

# 授权（预留）
LICENSE_KEY=
LICENSE_MODE=trial

# HuggingFace 镜像（中国大陆用户可用 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com
